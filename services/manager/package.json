{
  "name": "vtbank-manager-fn",
  "version": "1.0.0",
  "type": "module",
  "main": "handler.js",
  "scripts": {
    "predev": "node -e \"import('fs').then(fs => { const src='../../shared', dst='./shared'; if (fs.existsSync(dst)) fs.rmSync(dst,{recursive:true,force:true}); fs.cpSync(src,dst,{recursive:true,filter:(p)=>!p.includes('node_modules')}); });\"",
    "dev": "nodemon local-dev.js",
    "predeploy": "node -e \"import('fs').then(fs => { const src='../../shared', dst='./shared'; if (fs.existsSync(dst)) fs.rmSync(dst,{recursive:true,force:true}); fs.cpSync(src,dst,{recursive:true,filter:(p)=>!p.includes('node_modules')}); });\"",
    "deploy": "gcloud functions deploy manager-fn --runtime=nodejs22 --trigger-http --entry-point=handler --service-account=github-actions-deployer@vtbank-development.iam.gserviceaccount.com --allow-unauthenticated --gen2 --region asia-south1 --set-env-vars ENV=development"
  },
  "dependencies": {
    "express": "^5.2.1",
    "serverless-http": "^3.2.0",
    "cors": "^2.8.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "sequelize": "^6.37.8",
    "mysql2": "^3.23.3",
    "jsonwebtoken": "^9.0.3",
    "bcrypt": "^6.0.0",
    "generate-password": "^1.7.1",
    "joi": "^18.2.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}